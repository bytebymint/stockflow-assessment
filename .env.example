# Pooled PostgreSQL URL used by the application at runtime.
DATABASE_URL="postgresql://stockflow:password@localhost:5432/stockflow"

# Direct PostgreSQL URL used by Prisma migrations. For a local database this can
# match DATABASE_URL; Neon deployments should use the non-pooler connection.
DIRECT_URL="postgresql://stockflow:password@localhost:5432/stockflow"

# Assessment-only credentials. Replace every value before seeding and never use
# these accounts for a real production system.
DEMO_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
DEMO_CUSTOMER_PASSWORD="replace-with-a-strong-customer-password"
DEMO_SUPPLIER_PASSWORD="replace-with-a-strong-supplier-password"
DEMO_PENDING_SUPPLIER_PASSWORD="replace-with-a-strong-pending-password"
